rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================
    // PUBLIC READ ACCESS
    // Website content that anyone can view
    // ========================
    match /pricing/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email != null;
    }
    match /faq/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email != null;
    }
    match /brands/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email != null;
    }
    match /projects/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email != null;
    }

    // ========================
    // SALES + PUBLIC SUBMISSION ACCESS
    // Visitors can submit enquiries; the Sales portal (which uses client-side
    // sessions, NOT Firebase Auth) needs to read/update/delete them too.
    // Because sales users have no auth token, these are open.
    // ========================
    match /enquiries/{document} {
      allow read, update, delete: if true;
      allow create: if request.resource.data.name is string
                    && request.resource.data.phone is string;
    }
    match /contact_messages/{document} {
      allow read, delete: if request.auth != null && request.auth.token.email != null;
      allow create: if request.resource.data.name is string;
    }

    // ========================
    // SALES + ADMIN SHARED COLLECTIONS
    // The Sales portal (client-side sessions, no Firebase Auth) reads customers
    // and reads/writes quotations, so these cannot require an auth token.
    // ========================
    match /customers/{document} {
      allow read, write: if true;
    }
    match /quotations/{document} {
      allow read, write: if true;
    }
    match /admin_quotations/{document} {
      allow read, write: if true;
    }
    match /master_items/{document} {
      allow read, write: if true;
    }
    match /staff/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email != null;
    }
    match /attendance/{document} {
      allow read, write: if true;
    }
    match /service_requests/{document} {
      allow read, write: if true;
    }
    match /payments/{document} {
      allow read, write: if true;
    }
    match /invoices/{document} {
      allow read: if true;
      allow create, update, delete: if true;
    }
    match /smart_meter_installations/{document} {
      allow read, write: if request.auth != null && request.auth.token.email != null;
    }
    match /construction_work/{document} {
      allow read, write: if request.auth != null && request.auth.token.email != null;
    }
    // Live staff GPS positions written by the mobile app — one doc per staff
    // member, doc id = staff id = their Firebase Auth uid (see
    // scripts/provision_staff_auth.js). Only the signed-in staff member can
    // write their own position; any signed-in user (admins, staff) can read.
    match /staff_locations/{staffId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == staffId;
    }
    // Public read allowed so login flow can verify admin emails before Firebase Auth sign-in
    // Write is still restricted to authenticated admins only
    match /admins/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email != null;
    }

    // Sequential IDs for quotations and staff (counters/quotationCounter,
    // counters/staffId_<role-code>) are updated in transactions from the
    // Firebase-Auth'd admin panel — default-deny without this block.
    match /counters/{document} {
      allow read, write: if request.auth != null && request.auth.token.email != null;
    }
  }
}